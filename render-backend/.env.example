# Render backend environment — copy to .env and fill in. NEVER commit real values.

# Safe to expose publicly (also used by the frontend):
SUPABASE_URL=https://iadzcnzgbtuigyodeqas.supabase.co

# SERVER-ONLY. The service role bypasses RLS. If this leaks, rotate it
# immediately in Supabase Dashboard -> Settings -> API.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# CORS origins for the frontend app (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional overrides
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# RENDER_TIMEOUT_S=600
# TITLE_FONT_FILE=C:/Windows/Fonts/arialbd.ttf

# Optional Freesound official API provider. Search requires the API key.
# Original downloads require OAuth plus written commercial API approval.
# Keep FREESOUND_COMMERCIAL_API_APPROVED=false until that evidence exists.
FREESOUND_API_KEY=
FREESOUND_OAUTH_TOKEN=
FREESOUND_COMMERCIAL_API_APPROVED=false
FREESOUND_COMMERCIAL_API_APPROVAL_REFERENCE=
FREESOUND_TERMS_REVIEWED_AT=

# Optional local library override. Defaults to repository assets/audio.
# AUDIO_LIBRARY_ROOT=C:/path/to/private/audio-library

# ---- AWS S3 raw-footage uploads (SERVER-ONLY; set in Railway, never commit) ----
# When AWS_S3_BUCKET is set, customer raw footage uploads go browser->S3 via
# presigned multipart URLs. Credentials come from a least-privilege IAM user or
# (preferred) an attached instance role — the browser never sees them.
# AWS_S3_BUCKET=stromation-raw-footage
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=YOUR_IAM_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=YOUR_IAM_SECRET_ACCESS_KEY
# AWS_S3_ENDPOINT_URL=            # local dev / moto only; leave blank for AWS
# MAX_UPLOAD_BYTES=2147483648     # 2 GiB, shared with the frontend
# RAW_UPLOAD_PART_SIZE=16777216   # 16 MiB parts (>= 5 MiB S3 minimum)
# S3_PART_URL_EXPIRE_S=3600
# S3_GET_URL_EXPIRE_S=3600
# S3_SSE_ALGORITHM=AES256
# EXPORT_STORAGE_PROVIDER=supabase   # set to "s3" to also route exports to S3
