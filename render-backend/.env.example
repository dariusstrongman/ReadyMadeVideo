# Render backend environment — copy to .env and fill in. NEVER commit real values.

# Safe to expose publicly (also used by the frontend):
SUPABASE_URL=https://iadzcnzgbtuigyodeqas.supabase.co

# SERVER-ONLY. The service role bypasses RLS. If this leaks, rotate it
# immediately in Supabase Dashboard -> Settings -> API.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# CORS origins for the frontend app (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional overrides
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# RENDER_TIMEOUT_S=600
# TITLE_FONT_FILE=C:/Windows/Fonts/arialbd.ttf

# Optional Freesound official API provider. Search requires the API key.
# Original downloads require OAuth plus written commercial API approval.
# Keep FREESOUND_COMMERCIAL_API_APPROVED=false until that evidence exists.
FREESOUND_API_KEY=
FREESOUND_OAUTH_TOKEN=
FREESOUND_COMMERCIAL_API_APPROVED=false
FREESOUND_COMMERCIAL_API_APPROVAL_REFERENCE=
FREESOUND_TERMS_REVIEWED_AT=

# Optional local library override. Defaults to repository assets/audio.
# AUDIO_LIBRARY_ROOT=C:/path/to/private/audio-library

# ---- AWS S3 raw-footage uploads (SERVER-ONLY; set in Railway, never commit) ----
# When AWS_S3_BUCKET is set, customer raw footage uploads go browser->S3 via
# presigned multipart URLs. Credentials come from a least-privilege IAM user or
# (preferred) an attached instance role — the browser never sees them.
# AWS_S3_BUCKET=stromation-video-assets
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=YOUR_IAM_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=YOUR_IAM_SECRET_ACCESS_KEY
# AWS_S3_ENDPOINT_URL=            # local dev / moto only; leave blank for AWS
# MAX_UPLOAD_BYTES=2147483648     # 2 GiB, shared with the frontend
# RAW_UPLOAD_PART_SIZE=16777216   # 16 MiB parts (>= 5 MiB S3 minimum)
# S3_PART_URL_EXPIRE_S=3600
# S3_GET_URL_EXPIRE_S=3600
# S3_SSE_ALGORITHM=AES256
# EXPORT_STORAGE_PROVIDER=supabase   # set to "s3" to also route exports to S3

# ============================================================================
# FEATURE FLAGS AND OPERATIONAL VARIABLES (B11 — the authoritative registry;
# every entry below is read by shipped code. Names/defaults verified against
# source. Rollback for ANY flag: unset it and restart — no state migration.)
# ============================================================================

# ---- engines -----------------------------------------------------------------
# Master switch for the V2 customer journey (analysis -> Editorial Planner ->
# Picture Edit Engine V2). Default OFF = legacy autoedit. Truthy: 1/true/yes.
# Requires GEMINI_API_KEY, or every customer edit fails at planning.
# PICTURE_EDIT_ENGINE_V2_ENABLED=1

# ---- Phase 2 editorial intelligence (all default OFF; independent — the
# interest gate scores only the subsystems that are enabled) ------------------
# Rollout order recommendation: DIALOGUE -> HOOK -> COHERENCE -> TENSION ->
# INTEREST_GATE. All are no-ops unless PICTURE_EDIT_ENGINE_V2_ENABLED is on
# for customer plans (operator-triggered plans honor them regardless).
# PHASE2_DIALOGUE=1        # cuts may not sever spoken words (snap-then-reject)
# PHASE2_HOOK=1            # ranked hook shortlist + curiosity-loop ledger
# PHASE2_COHERENCE=1       # captions must add info; word-timed; <=17 cps
# PHASE2_TENSION=1         # energy shape: variance, payoff peak, no late longueur
# PHASE2_INTEREST_GATE=1   # scored floor over the ENABLED subsystems
# PHASE2_INTEREST_THRESHOLD=60   # 0-100; garbage values fall back to 60

# ---- AI providers ------------------------------------------------------------
# GEMINI_API_KEY=            # semantic analysis, planner, critic (degrades off)
# OPENAI_API_KEY=            # Whisper transcription (degrades off)
# EDITORIAL_PLANNER_MODEL=gemini-2.5-pro
# GEMINI_VIDEO_MODEL=gemini-2.5-flash
# GEMINI_CRITIC_MODEL=       # legacy critic model override
# GEMINI_NL_MODEL=           # conversational-edit model override

# ---- AI spend controls (B10 — finite by DEFAULT; a config typo can never
# mean unlimited. Explicit "off"/"unlimited" disables a ceiling, loudly.) ------
# AI_BUDGET_PER_JOB_USD=2.50
# AI_BUDGET_PER_PROJECT_USD=10.00

# ---- storage -----------------------------------------------------------------
# AWS_S3_BUCKET=             # unset = legacy Supabase uploads; set = S3 multipart
# AWS_REGION=us-east-1
# AWS_S3_ENDPOINT_URL=       # S3-compatible endpoint override
# S3_PART_URL_EXPIRE_S=3600
# S3_GET_URL_EXPIRE_S=3600
# S3_SSE_ALGORITHM=AES256
# RAW_UPLOAD_PART_SIZE=
# RAW_UPLOAD_TTL_S=
# EXPORT_STORAGE_PROVIDER=supabase   # supabase | s3 (previews + exports sign
#                                    # from the store each object was written to)

# ---- worker ------------------------------------------------------------------
# WORKER_ENABLED=1           # 0 = API serves, processes no jobs
# WORKER_CONCURRENCY=1       # read+logged; loop is currently single-threaded
# JOB_POLL_INTERVAL_S=3
# JOB_STALE_AFTER_S=900      # heartbeats now refresh during renders and
#                            # between planner attempts/provider calls (B8)
# MAX_ACTIVE_JOBS_PER_USER=4
# MAX_PLAN_RETRIES=3         # whole-plan auto-retries after PlanRejected
# AUTOEDIT_MAX_REVISIONS=2   # legacy critic/revision loop cap
# OPERATOR_RATE_LIMIT_PER_MIN=
# MAX_UPLOAD_BYTES=
# MAX_BODY_BYTES=
# PRICING_FILE=pricing.json  # cost-estimate line items (B9: token-based)
