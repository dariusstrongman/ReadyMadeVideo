# Stromation environment variable inventory (names + placeholders ONLY).
# Real values live in approved secret stores (n8n credential storage / platform
# secret managers) and are NEVER committed anywhere.

# --- public configuration ---
PUBLIC_SITE_URL=https://www.stromation.com

# --- website form -> workflow ---
FORM_API_SECRET=replace_me            # authenticates server-to-n8n submissions if enabled
N8N_WEBHOOK_BASE_URL=https://your-n8n-host/webhook

# --- CRM / data ---
CRM_PROVIDER=supabase                 # adapter selector
CRM_API_TOKEN=replace_me              # service-role key, server-side only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace_me       # never in frontend code; frontend uses anon key only

# --- telephony / messaging (only when a customer install uses SMS) ---
TWILIO_ACCOUNT_SID=replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_MESSAGING_SERVICE_SID=replace_me   # A2P-registered messaging service

# --- AI ---
AI_PROVIDER_API_KEY=replace_me

# --- calendar / booking ---
CALENDAR_API_TOKEN=replace_me

# --- operations ---
ALERT_WEBHOOK_URL=replace_me          # internal incident alert destination
N8N_ENCRYPTION_KEY=replace_me         # critical: stable, backed up securely, outside VCS
ENVIRONMENT=development               # development | staging | production
